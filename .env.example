# Ordered fallback chain. Change this value to change provider selection.
LLM_PROVIDER_ORDER=openai,gemini,openrouter,groq
LLM_MAX_OUTPUT_TOKENS=4096

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional additional OpenAI-compatible providers. For each name, set
# NAME_API_KEY, NAME_BASE_URL, and NAME_MODEL and include it in provider order.
# LLM_COMPATIBLE_PROVIDERS=example
# EXAMPLE_API_KEY=
# EXAMPLE_BASE_URL=https://api.example.com/v1
# EXAMPLE_MODEL=example-model
